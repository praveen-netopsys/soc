# ==============================================================================
# Explain Studio Backend Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit the actual .env file or credentials to source control.

# ------------------------------------------------------------------------------
# Remote AI / Ollama Inference (via SSH Tunnel)
# ------------------------------------------------------------------------------
# Windows local forwarded port from the remote Ubuntu GPU server.
# Ubuntu server runs Ollama on 127.0.0.1:11434, forwarded to Windows port 11435:
# ssh -N -L 11435:127.0.0.1:11434 user@server
EXPLAIN_STUDIO_OLLAMA_BASE_URL=http://127.0.0.1:11435

# Connection probe timeout in seconds (default: 5.0)
EXPLAIN_STUDIO_OLLAMA_TIMEOUT_SECONDS=5.0

# Inference timeout in seconds for deep text/vision reasoning (default: 180.0)
EXPLAIN_STUDIO_OLLAMA_INFERENCE_TIMEOUT_SECONDS=180.0

# Model identifiers installed on remote Ollama instance
EXPLAIN_STUDIO_OLLAMA_TEXT_MODEL=qwen2.5:14b
EXPLAIN_STUDIO_OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Inference parameters
EXPLAIN_STUDIO_OLLAMA_NUM_CTX=32768
EXPLAIN_STUDIO_OLLAMA_NUM_PREDICT=2048
EXPLAIN_STUDIO_OLLAMA_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# Video Rendering Specifications
# ------------------------------------------------------------------------------
EXPLAIN_STUDIO_VIDEO_WIDTH=1920
EXPLAIN_STUDIO_VIDEO_HEIGHT=1080
EXPLAIN_STUDIO_VIDEO_FPS=30

# ------------------------------------------------------------------------------
# Narration / Speech Synthesis (TTS)
# ------------------------------------------------------------------------------
# Provider options: 'auto' (prefers neural edge-tts with offline fallback), 'edge', 'offline'
EXPLAIN_STUDIO_TTS_PROVIDER=auto
EXPLAIN_STUDIO_TTS_VOICE=en-US-ChristopherNeural

# ------------------------------------------------------------------------------
# Storage and Upload Limits
# ------------------------------------------------------------------------------
# Max single file upload in bytes (default: 50MB)
EXPLAIN_STUDIO_MAX_FILE_BYTES=52428800
# Max total upload per generation request in bytes (default: 100MB)
EXPLAIN_STUDIO_MAX_TOTAL_BYTES=104857600
# Max files per request
EXPLAIN_STUDIO_MAX_FILES=15
